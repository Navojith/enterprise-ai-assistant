# Copy to .env and fill in. .env is gitignored; this file is committed and must stay in sync
# whenever a variable is added (see CLAUDE.md). Full setup instructions: docs/SETUP.md.
#
# Do not attach a payment method to the Pinecone or LangSmith account — both hard-cap free
# usage with no card on file. See docs/DECISIONS.md §4.

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Pinecone (Cycle 1) — leave blank until the Starter account exists ---
PINECONE_API_KEY=
PINECONE_DENSE_INDEX=enterprise-assistant-dense
PINECONE_SPARSE_INDEX=enterprise-assistant-sparse

# --- LangSmith (Cycle 3) — leave blank until the Developer account exists ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-ai-assistant
LANGSMITH_TRACING=false

# --- Ollama (Cycle 3) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_STREAM_STALL_TIMEOUT_SECONDS=30
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# --- Agent graph (Cycle 3) ---
MAX_VALIDATOR_RETRIES=1
MEMORY_MAX_VERBATIM_MESSAGES=12
MEMORY_SUMMARIZE_BATCH_SIZE=6

# --- Postgres (Cycle 0 infra; consumed from Cycle 2 onward) ---
# docker-compose.yml reads these same names to provision the container, so change them here
# once rather than in two places. Settings assembles the connection string from these parts.
# Port 5433, not Postgres's default 5432 — see docs/SETUP.md's troubleshooting table.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=enterprise_ai_assistant
DB_USER=postgres
DB_PASSWORD=postgres

# --- Auth (Cycle 2) — generate a real secret before Cycle 2, e.g. `openssl rand -hex 32` ---
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60

# --- Reranking budget guard (Cycle 1) — Pinecone Starter includes 500 requests/month ---
RERANK_ENABLED=false
RERANK_MONTHLY_BUDGET=450

# --- Rate limiting (Cycle 2) — token bucket, per user ---
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SEC=0.5

# --- MCP server + client (Cycle 4) — read by both sides so they can't disagree ---
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8100
MCP_SERVER_PATH=/mcp
MCP_CONNECT_TIMEOUT_SECONDS=5
MCP_CALL_TIMEOUT_SECONDS=10

# --- Tools (Cycle 4) ---
SANDBOX_TIMEOUT_SECONDS=5

# --- RLM research agent (Cycle 5) ---
# Depth 1 and concurrency 1 are deliberate for this project's single local `qwen3:4b` instance
# (docs/DECISIONS.md §3) — verified live that raising either causes concurrent LLM calls to
# queue inside Ollama and time out. Raise only for an LLM backend with real spare capacity.
# The 750s timeout and 8-call budget are sized together for sequential (concurrency=1)
# execution of up to 8 sub-agent calls plus plan generation and aggregation, each running with
# reasoning=True — raised twice, live-verified each time: 90s then 180s both cut a real,
# otherwise-successful run short (docs/ASSUMPTIONS_AND_TRADEOFFS.md trade-off 27), and a
# 4-call budget then proved too narrow once batching started correctly respecting document
# boundaries (trade-off 28) — see docs/DECISIONS.md §9 for the full sequence of raises.
RLM_PLAN_TIMEOUT_SECONDS=750
RLM_MAX_DEPTH=1
RLM_MAX_CONCURRENT_SUB_AGENTS=1
RLM_MAX_TOTAL_SUB_AGENT_CALLS=8
